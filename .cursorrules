{
  phoneVerified: Boolean,
  codTier: String, // NEW, BRONZE, SILVER, GOLD
  codBlockedUntil: Date,
  trustScore: Number,
  walletBalance: Number
}

// New Models
- Wallet (deposits, refunds)
- OTP (verification)
```

